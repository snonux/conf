#!/bin/sh
# wireguard-watchdog -- restart the WireGuard mesh link when it is broken.
#
# NetBSD 11 has no in-kernel wg(4) on these Pis, so the mesh runs the
# userspace wireguard-go daemon behind /etc/rc.d/wireguard (generated by
# wireguardmeshgenerator). When that daemon dies, nothing restarts it: on
# 2026-09-16 it vanished on pi1 without a log line and the host stayed off the
# mesh for nine days, leaving tun0 down with its address DETACHED.
#
# Run from root's cron. A healthy link costs a pgrep, a `wg show` and an
# ifconfig, and prints nothing. A broken one gets a full stop/start, which
# rebuilds tun0, the daemon, the crypto config and the host routes.
#
# A restart that does not bring the link back prints to stderr once, on the
# first failed run ($FAILED_FLAG marks the streak), so cron's mail cannot pile
# up every 5 minutes while the link stays down. Root mail on the Pis is local
# and rarely read, though: the alert that actually reaches someone is Gogios
# pinging the Pi's mesh address from the frontends.
#
# It stays out of the way when:
#   - wireguard is not enabled in rc.conf (rc.d would refuse to start it),
#   - /var/run/wireguard-watchdog.disable exists (maintenance: a deliberate
#     "/etc/rc.d/wireguard stop" would otherwise be undone within 5 minutes),
#   - unattended-upgrade-netbsd holds its lock (it restarts wireguard itself,
#     and interleaving two stop/start sequences can destroy tun0 under the
#     other or launch a second daemon).

IF=tun0
DAEMON="/usr/pkg/bin/wireguard-go ${IF}"
DISABLE_FILE=/var/run/wireguard-watchdog.disable
UNATTENDED_LOCK=/var/run/unattended-upgrade.lock
FAILED_FLAG=/var/run/wireguard-watchdog.failed

. /etc/rc.subr
load_rc_config wireguard
checkyesno wireguard || exit 0
[ -e "$DISABLE_FILE" ] && exit 0
[ -e "$UNATTENDED_LOCK" ] && exit 0

# link_ok -- the daemon runs, answers on its UAPI socket (a hung or
# half-configured daemon fails `wg show`), and tun0 is up.
link_ok() {
	pgrep -f "${DAEMON}" >/dev/null &&
		/usr/pkg/bin/wg show "${IF}" >/dev/null 2>&1 &&
		/sbin/ifconfig "${IF}" 2>/dev/null | grep -q '<UP,'
}

if link_ok; then
	rm -f "$FAILED_FLAG"
	exit 0
fi

logger -p daemon.err -t wireguard-watchdog "${IF} link broken; restarting wireguard"
# The rc script prints every route it adds or deletes; send that to syslog
# rather than stdout, which cron would mail to root on every restart.
/etc/rc.d/wireguard stop 2>&1 | logger -t wireguard-watchdog
/etc/rc.d/wireguard start 2>&1 | logger -t wireguard-watchdog

if link_ok; then
	rm -f "$FAILED_FLAG"
	logger -p daemon.notice -t wireguard-watchdog "wireguard restarted"
else
	msg="wireguard restart failed: ${IF} link still broken"
	logger -p daemon.err -t wireguard-watchdog "$msg"
	if [ ! -e "$FAILED_FLAG" ]; then
		touch "$FAILED_FLAG"
		echo "wireguard-watchdog: $msg (further failures go to syslog only)" >&2
	fi
	exit 1
fi
