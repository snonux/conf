#!/bin/ksh
#
# shelly-tls-probe -- hourly check of the Shelly plugs' HTTPS certificates
# from the controllers pi0/pi1 (task s44). Installed by gonf
# (pis_netbsd_shelly_tls_*, gonf/netbsd/shelly_tls.go).
#
# For every plug it does a real TLS handshake on TCP443 and verifies the
# certificate the plug presented against the pinned private f3s Shelly CA,
# the same file f3sctl trusts (/usr/local/etc/f3sctl/shelly-ca.pem). So a
# missing or swapped CA file, a swapped plug certificate, a wrong IP SAN and
# an expired certificate all show up, not only the calendar date. The
# results go to the in-cluster Pushgateway, where Prometheus alerts on them
# (f3s/prometheus/manifests/shelly-tls-alerts.yaml) and Gogios shows the
# firing alerts.
#
# Verification is done by `openssl verify` on the exact leaf the handshake
# returned, with only the pinned CA as trust anchor (-no-CApath -no-CAstore:
# the system roots and SSL_CERT_DIR are never consulted), the plug's IP as
# required SAN and serverAuth as purpose. The handshake itself proves that
# the plug holds the leaf's private key (TLS 1.2 ECDHE-ECDSA: the client
# checks the key exchange signature with the leaf's key), so s_client does
# not need to verify; it only fetches the leaf.
#
# Metrics (one Pushgateway group per reporter: job=shelly_tls,
# reporter=<short hostname>; a PUT replaces the whole group each run):
#
#   shelly_tls_probe_success{plug,address}        1 verified, 0 otherwise
#       (s44 review B1: also 0 when the verified leaf's notAfter cannot be
#       read, so a parsing failure after an OpenSSL/date change never
#       passes as OK while hiding the expiry alerts)
#   shelly_tls_cert_not_after_seconds{plug,cert="leaf"}
#       the plug leaf's notAfter, only when the leaf chains to the pinned CA
#       (also when it is merely expired or not yet valid, so an expired
#       certificate reads as expired instead of vanishing); an unknown
#       certificate gets no value, its probe_success 0 is the signal
#   shelly_tls_cert_not_after_seconds{cert="ca"}
#       the earliest notAfter of all certificates in the pinned CA file, so
#       a rollover file holding an old and a new CA cannot hide either; when
#       any of them is unreadable the series is left out and the run exits
#       1 (the rule ShellyTLSCAExpiryUnknown alerts on the missing series)
#   shelly_tls_probe_last_success_timestamp_seconds{plug}
#       last fully verified run on this host (0: never), kept in STATE_DIR so
#       "failing for more than 2h" survives Prometheus and Pushgateway
#       restarts (the cluster is powered off most nights)
#   shelly_tls_probe_last_run_timestamp_seconds   this run (staleness)
#
# Exit codes: 0 all plugs verified and pushed, 1 at least one plug failed
# or the CA's notAfter was unreadable (results still pushed), 2 the push
# failed on every Pushgateway address, 64 usage or configuration error. Diagnostics go to stderr; the cron job
# hands them to syslog. "-n" prints the metrics instead of pushing (deploy
# checks and the fixture check-shelly-tls-probe.py).
#
# Everything below can be overridden from the environment (used by the
# fixture; the cron job relies on the defaults):
#
#   SHELLY_TLS_CA_FILE     pinned CA (default: f3sctl's CA file)
#   SHELLY_TLS_PLUGS       "name=host[:port] ..." (default: both plugs, 443)
#   SHELLY_TLS_PUSH_URLS   Pushgateway base URLs, tried in order until one
#                          accepts. Default: the Local NodePort
#                          pushgateway-lan (30091) on r0, r1, r2; only the
#                          node running the Pushgateway pod answers.
#   SHELLY_TLS_REPORTER    reporter label (default: hostname -s)
#   SHELLY_TLS_STATE_DIR   last-success records (default /var/db/shelly-tls-probe)
#   SHELLY_TLS_TIMEOUT     seconds per TLS handshake (default 15)
#   SHELLY_TLS_PATH        command search path (the fixture puts failing
#                          date/openssl stand-ins first)
#
# The cron job runs as the unprivileged account _shellytls (it parses
# certificates from the network on hosts that serve a public site); it needs
# only read access to the CA file and write access to STATE_DIR.

PATH=${SHELLY_TLS_PATH:-/sbin:/bin:/usr/sbin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin}
export PATH

CA_FILE=${SHELLY_TLS_CA_FILE:-/usr/local/etc/f3sctl/shelly-ca.pem}
PLUGS=${SHELLY_TLS_PLUGS:-"shelly1=10.30.0.28 shelly2=10.30.0.29"}
PUSH_URLS=${SHELLY_TLS_PUSH_URLS:-"http://10.20.0.120:30091 http://10.20.0.121:30091 http://10.20.0.122:30091"}
REPORTER=${SHELLY_TLS_REPORTER:-$(hostname -s)}
STATE_DIR=${SHELLY_TLS_STATE_DIR:-/var/db/shelly-tls-probe}
TIMEOUT=${SHELLY_TLS_TIMEOUT:-15}
JOB=shelly_tls

function log {
    printf 'shelly-tls-probe: %s\n' "$*" >&2
}

function die_usage {
    log "$*"
    exit 64
}

# cert_not_after FILE: the certificate's notAfter as Unix time, or nothing.
# Both NetBSD's and GNU date(1) parse openssl's "Feb 11 07:16:58 2029 GMT".
function cert_not_after {
    typeset raw epoch
    raw=$(openssl x509 -in "$1" -noout -enddate 2>/dev/null) || return 1
    epoch=$(date -u -d "${raw#notAfter=}" +%s 2>/dev/null) || return 1
    case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$epoch"
}

# ca_not_after: the earliest notAfter of every certificate in CA_FILE. Fails
# when the file holds no certificate or any notAfter is unreadable.
function ca_not_after {
    typeset part epoch min=
    awk -v dir="$WORK" '
        /-----BEGIN CERTIFICATE-----/ { n++; out = dir "/ca." n ".pem" }
        out != "" { print > out }
        /-----END CERTIFICATE-----/ { close(out); out = "" }' "$CA_FILE" || return 1
    for part in "$WORK"/ca.*.pem; do
        [ -e "$part" ] || return 1
        epoch=$(cert_not_after "$part") || return 1
        if [ -z "$min" ] || [ "$epoch" -lt "$min" ]; then
            min=$epoch
        fi
    done
    printf '%s\n' "$min"
}

# fetch_leaf HOST PORT OUT: complete a TLS handshake and save the leaf the
# plug presented as PEM in OUT. Fails on no connection, a failed handshake
# or a timeout; nothing here trusts the certificate yet.
function fetch_leaf {
    typeset transcript=$3.transcript rc
    timeout "$TIMEOUT" openssl s_client -connect "$1:$2" -noservername \
        </dev/null >"$transcript" 2>/dev/null
    rc=$?
    if [ "$rc" != 0 ]; then
        log "$1:$2 handshake failed (exit $rc)"
        return 1
    fi
    sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/{p;/-----END CERTIFICATE-----/q;}' \
        "$transcript" >"$3"
    if ! openssl x509 -in "$3" -noout 2>/dev/null; then
        log "$1:$2 presented no parseable certificate"
        return 1
    fi
}

# verify_leaf LEAF IP [extra openssl verify options]: chain to the pinned CA
# only, IP SAN and serverAuth required.
function verify_leaf {
    typeset leaf=$1 ip=$2
    shift 2
    openssl verify -CAfile "$CA_FILE" -no-CApath -no-CAstore \
        -purpose sslserver -verify_ip "$ip" "$@" "$leaf" >/dev/null 2>&1
}

# record_success PLUG NOW: remember the last verified run (atomic rename).
function record_success {
    printf '%s\n' "$2" >"$STATE_DIR/$1.last_success.tmp" &&
        mv "$STATE_DIR/$1.last_success.tmp" "$STATE_DIR/$1.last_success"
}

# last_success PLUG: the recorded last verified run, 0 when there is none.
function last_success {
    typeset value=
    [ -r "$STATE_DIR/$1.last_success" ] && read -r value <"$STATE_DIR/$1.last_success"
    case "$value" in ''|*[!0-9]*) value=0 ;; esac
    printf '%s\n' "$value"
}

# probe_plug NAME HOST PORT NOW: probe one plug and append its sample lines
# to the per-family files in WORK. Returns 1 when the plug did not verify.
function probe_plug {
    typeset name=$1 host=$2 port=$3 now=$4 leaf=$WORK/$1.pem success=0 not_after
    if fetch_leaf "$host" "$port" "$leaf"; then
        if verify_leaf "$leaf" "$host"; then
            success=1
        elif verify_leaf "$leaf" "$host" -no_check_time; then
            log "$name ($host) certificate is genuine but outside its validity period"
        else
            log "$name ($host) certificate does not verify against $CA_FILE"
        fi
        # notAfter only for a certificate the pinned CA issued for this IP.
        # A verified leaf whose date cannot be read counts as a failure:
        # success 1 without a notAfter would silence the expiry alerts.
        if [ "$success" = 1 ] || verify_leaf "$leaf" "$host" -no_check_time; then
            if not_after=$(cert_not_after "$leaf"); then
                printf 'shelly_tls_cert_not_after_seconds{plug="%s",cert="leaf"} %s\n' \
                    "$name" "$not_after" >>"$WORK/not_after"
            else
                log "$name ($host) leaf notAfter unreadable (openssl x509 -enddate or date -d failed); reporting the plug as failed"
                success=0
            fi
        fi
    fi
    if [ "$success" = 1 ]; then
        record_success "$name" "$now" || log "cannot write $STATE_DIR/$name.last_success"
    fi
    printf 'shelly_tls_probe_success{plug="%s",address="%s"} %s\n' \
        "$name" "$host" "$success" >>"$WORK/success"
    printf 'shelly_tls_probe_last_success_timestamp_seconds{plug="%s"} %s\n' \
        "$name" "$(last_success "$name")" >>"$WORK/last_success"
    [ "$success" = 1 ]
}

# family NAME HELP SAMPLES: one metric family in text exposition format.
function family {
    [ -s "$3" ] || return 0
    printf '# HELP %s %s\n# TYPE %s gauge\n' "$1" "$2" "$1"
    cat "$3"
}

# render NOW: the full exposition document from the per-family files.
function render {
    family shelly_tls_probe_success \
        'Plug completed a TLS handshake on 443 and its certificate verified against the pinned Shelly CA.' \
        "$WORK/success"
    family shelly_tls_cert_not_after_seconds \
        'notAfter (Unix time) of a plug leaf (cert=leaf, only if issued by the pinned CA) or of the pinned CA (cert=ca).' \
        "$WORK/not_after"
    family shelly_tls_probe_last_success_timestamp_seconds \
        'Last run on this reporter in which the plug verified (0: never).' \
        "$WORK/last_success"
    printf '%s\n' "shelly_tls_probe_last_run_timestamp_seconds $1" >"$WORK/last_run"
    family shelly_tls_probe_last_run_timestamp_seconds \
        'Time of the last probe run on this reporter.' "$WORK/last_run"
}

# push FILE: PUT the group to the first Pushgateway address that accepts it.
# The NodePort is Local, so the nodes without the pod time out on every run;
# those attempts are logged only when no address accepted the push.
function push {
    typeset url rc tried=
    for url in $PUSH_URLS; do
        curl -s --fail --connect-timeout 3 --max-time 10 -X PUT \
            --data-binary "@$1" "$url/metrics/job/$JOB/reporter/$REPORTER" >/dev/null
        rc=$?
        [ "$rc" = 0 ] && return 0
        tried="$tried $url (curl exit $rc)"
    done
    log "push failed:$tried"
    return 1
}

function main {
    typeset dry_run=no entry name target host port now failed=0 ca_not_after

    case "$1" in
        -n) dry_run=yes ;;
        '') ;;
        *) die_usage "usage: shelly-tls-probe [-n]" ;;
    esac
    case "$REPORTER" in
        ''|*[!a-z0-9_-]*) die_usage "invalid reporter name '$REPORTER'" ;;
    esac
    case "$TIMEOUT" in ''|*[!0-9]*) die_usage "invalid timeout '$TIMEOUT'" ;; esac
    [ -n "$PLUGS" ] || die_usage "no plugs configured"
    if [ ! -d "$STATE_DIR" ]; then
        die_usage "state directory $STATE_DIR missing"
    fi

    now=$(date +%s)

    for entry in $PLUGS; do
        name=${entry%%=*}
        target=${entry#*=}
        case "$name" in
            ''|*[!a-z0-9_-]*) die_usage "invalid plug entry '$entry'" ;;
        esac
        host=${target%:*}
        port=443
        [ "$host" != "$target" ] && port=${target##*:}
        probe_plug "$name" "$host" "$port" "$now" || failed=1
    done

    if [ ! -r "$CA_FILE" ]; then
        log "pinned CA $CA_FILE missing or unreadable"
        failed=1
    elif ca_not_after=$(ca_not_after); then
        printf 'shelly_tls_cert_not_after_seconds{cert="ca"} %s\n' \
            "$ca_not_after" >>"$WORK/not_after"
    else
        log "pinned CA $CA_FILE: no certificate, or a notAfter unreadable (openssl x509 -enddate or date -d failed)"
        failed=1
    fi

    render "$now" >"$WORK/metrics"
    if [ "$dry_run" = yes ]; then
        cat "$WORK/metrics"
    elif ! push "$WORK/metrics"; then
        log "push failed on every Pushgateway address"
        return 2
    fi
    [ "$failed" = 0 ] || log "at least one plug did not verify, or the CA notAfter is unknown"
    return "$failed"
}

# The scratch directory and its cleanup live at the top level: ksh93 scopes
# traps set inside a "function" to that function.
WORK=$(mktemp -d "${TMPDIR:-/tmp}/shelly-tls-probe.XXXXXX") || exit 64
trap 'rm -rf "$WORK"' EXIT
trap 'exit 70' HUP INT TERM
main "$@"
exit $?
