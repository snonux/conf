# Dormant Pi-hole migration policy. Replace only this owner's table atomically.
add table inet f3s_guard
delete table inet f3s_guard
table inet f3s_guard {
    chain before_dnat {
        type filter hook prerouting priority -150; policy accept;
        iifname "eth0" fib daddr type local jump from_lan
    }
    chain from_lan {
        ct state established,related return
        # Task j24 retired the igc1 recovery aliases 10.98.0.127/.128 and
        # their laptop-only SSH chain: such destinations fall to the drop.
        # Task 074: the old 192.168.1.0/24 resolver addresses were retired in
        # i24 and the router never forwards that subnet to the lab, so no old
        # IPv4 source or destination is trusted any more.
        # Old physical ULA: IPv6 compatibility, outside the IPv4 retirement.
        ip6 saddr fd22:c702:acb7::/64 return
        ip saddr 10.20.0.0/24 ip daddr 10.20.0.0/24 return
        ip6 saddr fd02:ca0b:f1cb:20::/64 ip6 daddr fd02:ca0b:f1cb:20::/64 return
        # Match the router's two identities and resolver-only DNS exception.
        ip saddr { 10.99.0.2, 10.99.0.3 } ip daddr { 10.20.0.127, 10.20.0.128 } udp dport 53 return
        ip saddr { 10.99.0.2, 10.99.0.3 } ip daddr { 10.20.0.127, 10.20.0.128 } tcp dport 53 return
        ip saddr 10.99.0.2 ip daddr { 10.20.0.127, 10.20.0.128 } tcp dport { 22, 80, 443 } return
        ip saddr 10.99.0.3 ip daddr { 10.20.0.127, 10.20.0.128 } tcp dport 443 return
        # Preserve existing diagnostics and old-mode IPv6 boot recovery.
        # The migration profile owns RA suppression/manual ULA in new mode.
        meta l4proto { icmp, ipv6-icmp } return
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 return
        counter drop
    }
}
