[Unit]
Description=Complete resolver boot network and service rollback
After=NetworkManager.service docker.service gonf-network-rollback-boot.service
Requires=NetworkManager.service docker.service gonf-network-rollback-boot.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gonf-network-migration restore-after-boot
TimeoutStartSec=180
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
