max connections = 5
timeout = 300
reverse lookup = no
hosts deny = *

[joernshtdocs]
comment = Joerns htdocs
path = /var/www/htdocs/joern
read only = yes
list = yes
uid = www
gid = www
hosts allow = {{ range .Readers }}{{ . }} {{ end }}

[irregular-ninja]
comment = Irregular Ninja photo album (push from k3s over wg0)
path = /var/www/htdocs/irregular.ninja
read only = no
list = no
uid = www
gid = www
hosts allow = {{ range .Publishers }}{{ . }} {{ end }}
auth users = shuriken
secrets file = /etc/rsyncd.secrets
strict modes = yes

[foostats-private]
comment = Private Foostats visitor counters for WireGuard peers
path = /var/db/foostats
read only = yes
list = no
uid = www
gid = www
hosts allow = {{ range .StatsPeers }}{{ . }} {{ end }}

[alt-irregular-ninja]
comment = Alternative Irregular Ninja photo album (push from k3s over wg0)
path = /var/www/htdocs/alt.irregular.ninja
read only = no
list = no
uid = www
gid = www
hosts allow = {{ range .Publishers }}{{ . }} {{ end }}
auth users = shuriken
secrets file = /etc/rsyncd.secrets
strict modes = yes
