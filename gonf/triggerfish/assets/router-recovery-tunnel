#!/usr/bin/perl
# Temporary outbound SSH management; no network configuration or rollback here.
use strict;
use warnings;
use Fcntl qw(LOCK_EX LOCK_NB);
use Errno qw(EAGAIN EWOULDBLOCK);

umask 0077;
my $action = shift // '';
if (@ARGV || ($action ne 'start' && $action ne 'stop')) {
    print STDERR "usage: router-recovery-tunnel start|stop\n";
    exit 2;
}

my $dir = '/etc/gonf/router-recovery';
my @ssh = ('/usr/bin/ssh', '-F', "$dir/ssh_config", '-S', "$dir/control");
exit 0 if $action eq 'start' && !-f "$dir/enabled";
open my $lock, '>>', "$dir/lock" or die "cannot open recovery lock: $!\n";

# Start may skip a concurrent operation; Stop must wait for an in-flight
# Start to finish. A timeout fails the gonf stop resource, preventing deletion
# of the identity/control files while the client might still be starting.
$SIG{ALRM} = sub { die "recovery lock timeout\n" };
alarm 60;
if (!flock($lock, LOCK_EX | ($action eq 'start' ? LOCK_NB : 0))) {
    exit 0 if $action eq 'start' && ($! == EAGAIN || $! == EWOULDBLOCK);
    die "cannot acquire recovery lock: $!\n";
}
alarm 0;

if ($action eq 'start') {
    # Recheck under the same lock used by Stop: a cron invocation that began
    # before retirement must not start a client after the marker is removed.
    exit 0 if !-f "$dir/enabled";
    exit 0 if master_alive(@ssh);
    open STDOUT, '>>', "$dir/client.log" or die "cannot open recovery log: $!\n";
    open STDERR, '>&', \*STDOUT or die "cannot redirect recovery log: $!\n";
    system(@ssh, '-fNT', '-M', 'gateway') == 0
        or die "recovery SSH start failed\n";
} elsif (master_alive(@ssh)) {
    system(@ssh, '-O', 'exit', 'gateway') == 0
        or die "recovery SSH stop failed\n";
}

# Keep the advisory lock in this parent until SSH has completed startup/stop.
# Perl's normal close-on-exec descriptors keep the daemonized SSH client from
# inheriting the lock and blocking every later cron/retirement operation.
close $lock or die "cannot close recovery lock: $!\n";

sub master_alive {
    my @command = @_;
    local *STDOUT;
    local *STDERR;
    open STDOUT, '>', '/dev/null' or die "cannot open null output: $!\n";
    open STDERR, '>', '/dev/null' or die "cannot open null error output: $!\n";
    return system(@command, '-O', 'check', 'gateway') == 0;
}
