apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: alloy
  namespace: cicd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://grafana.github.io/helm-charts
    chart: alloy
    targetRevision: 0.3.2
    helm:
      releaseName: alloy
      valuesObject:
        alloy:
          # Memory from the 14-day peak working set (184Mi), limit well above
          # it so the DaemonSet is never OOM-killed (audit 2026-09-25 #19).
          resources:
            requests:
              memory: 192Mi
            limits:
              memory: 1Gi
          # Disabled with Loki and Tempo (audit 2026-09-25 #16): this
          # no-op config shipped nothing and only sent Grafana Labs usage
          # reports. To re-enable, rename back to alloy.yaml, restore the
          # discovery/loki/otelcol blocks from git history and disable
          # reporting (alloy.enableReporting: false).
          configMap:
            content: |
              logging {
                level = "info"
              }

  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=false
    retry:
      limit: 3
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 1m
