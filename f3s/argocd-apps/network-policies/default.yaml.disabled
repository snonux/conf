# Manual activation only; pin targetRevision to the approved published commit first.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: network-policies-default
  namespace: cicd
spec:
  project: default
  source:
    repoURL: http://forgejo.services.svc.cluster.local/snonux/conf.git
    targetRevision: master
    path: f3s/network-policies/namespaces/default
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    syncOptions:
    - CreateNamespace=false
