#!/bin/sh /etc/rc.common
# Restore unconfirmed UCI files before S19dnsmasq and S20network.
# Read by /etc/rc.common rather than by this fragment itself.
# shellcheck disable=SC2034
START=18 STOP=10 USE_PROCD=1

start_service() {
    /usr/sbin/f3s-ap-network-recovery boot || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/f3s-ap-network-recovery watch
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
