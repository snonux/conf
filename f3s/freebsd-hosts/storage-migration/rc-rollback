#!/bin/sh
# PROVIDE: gonf_storage_rollback
# REQUIRE: FILESYSTEMS random sysctl
# BEFORE: netif routing
# KEYWORD: nojail
. /etc/rc.subr
name=gonf_storage_rollback
storage_rollback_start()
{
    storage_rollback_status=0
    /usr/local/sbin/gonf-storage-migration boot || storage_rollback_status=$?
    # Reload restored owned rc.conf aliases before netif consumes them.
    if [ -n "${autoboot:-}" ]; then kill -ALRM "$$"; fi
    return "$storage_rollback_status"
}
start_cmd=storage_rollback_start
stop_cmd=':'
run_rc_command "$1"
