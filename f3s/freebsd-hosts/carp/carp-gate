#!/bin/sh
# gonf-carp-gate (task 764): hold CARP at boot until the physical uplink
# really carries the peer's advertisements. Installed on the CARP members
# f0/f1 by gonf freebsd_carp_boot_gate (gonf/freebsd/carp.go); source
# f3s/freebsd-hosts/carp/carp-gate in the conf repo.
#
# Why (f1, 2026-11-12, VIP on the bridge vm-public): CARP follows the link
# state of the interface carrying the vhid. A bridge is "up" while any member
# is, so when vm-bhyve added the guest's tap0, the bridge stayed up although
# re0, the only real uplink, reset for ~4 s (if_bridge mutes TXCSUM/TSO on
# every member when a tap without them joins, and re(4) renegotiates the link
# on that change). f1 heard no advertisement for 3 x advbase, went
# BACKUP -> MASTER for a second, and its announcement moved the CARP MAC on
# the switch to f1's port.
#
# How:
#   - loader.conf sets net.inet.carp.allow="0". ip_carp.c reads it as a
#     tunable when the module loads ("to postpone carp start"), so every vhid
#     stays INIT through netif and the rest of rc: no adverts sent, none
#     accepted, no master-down timer.
#   - "start" (rc.d gonf_carp_gate, before netif) pre-mutes TXCSUM/TSO on the
#     uplink while it is still down, so no later bridge membership change
#     (tap joins at guest start, leaves at guest stop) alters its capabilities
#     and resets its link. The bridge mutes exactly these at runtime anyway.
#     Then it detaches the waiter.
#   - "wait" waits for the guest tap to join the uplink's bridge (when guests
#     autostart), for the uplink link to stay active for $settle seconds, and
#     for one vhid advertisement on the uplink, then sets allow=1: the vhid
#     goes INIT -> BACKUP with a working wire and hears the MASTER at once.
#     After $deadline seconds it allows CARP anyway, so a sole survivor
#     (peer down, cold start) still takes the VIP. The budget counts the
#     seconds the waiter spent, not wall-clock time, so an ntpd step at
#     boot neither shortens nor stretches it.
#
# Never lowers allow: "start" does nothing when allow is 1 or the loader did
# not ask for the hold, so a manual run cannot drop a VIP. It does release a
# hand-set allow=0, except the gonf-storage-migration "held" fence, which
# wins. A SIGTERM (shutdown during the window) exits without allowing: a
# host going down must not promote on a dead wire; release by hand with
# "sysctl net.inet.carp.allow=1". Remove the loader.conf line before this
# script, or CARP never starts.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH
self=/usr/local/libexec/gonf-carp-gate
logfile=/var/log/gonf-carp-gate.log
storage_held=/var/db/gonf-storage-migration/held
# shellcheck source=/dev/null
. /usr/local/etc/gonf-carp-gate.conf
: "${uplink:?}" "${vhid:?}" "${settle:?}" "${deadline:?}"

log() {
    printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$logfile"
    # syslogd starts after netif: early lines only reach the file.
    logger -t gonf-carp-gate -- "$*" 2>/dev/null || :
}

link_active() { ifconfig "$uplink" 2>/dev/null | grep -q 'status: active'; }

# The uplink stays active for $settle one-second samples. A re(4) reset
# keeps the link down for seconds, so a sample catches it. Each sample
# spends one second of the budget.
stable() {
    i=0
    while [ "$i" -lt "$settle" ]; do
        sleep 1
        left=$((left - 1))
        link_active || return 1
        i=$((i + 1))
    done
}

# One advertisement of our vhid (byte 1 of the CARP header) to 224.0.0.18
# on the uplink. allow=0 keeps this host silent, so it is the peer's.
heard() {
    left=$((left - 4))
    timeout 4 tcpdump -c 1 -n -i "$uplink" \
        "ip proto 112 and dst host 224.0.0.18 and ip[((ip[0] & 0xf) << 2) + 1] = $vhid" \
        >/dev/null 2>&1
}

# With autostarting guests, wait for a tap on the uplink's bridge: before
# the move vm-bhyve creates that bridge, after it rc.conf does; either way
# the tap joins when the guest starts.
wait_tap() {
    case "$(sysrc -n vm_enable 2>/dev/null)" in [Yy][Ee][Ss]) ;; *) return 0 ;; esac
    [ -n "$(sysrc -n vm_list 2>/dev/null)" ] || return 0
    while [ "$left" -gt 0 ]; do
        for b in $(ifconfig -g bridge 2>/dev/null); do
            members=$(ifconfig "$b" 2>/dev/null)
            case "$members" in *"member: $uplink "*)
                case "$members" in *"member: tap"*) log "guest tap joined $b"; return 0 ;; esac ;;
            esac
        done
        sleep 1
        left=$((left - 1))
    done
    log "no guest tap joined a bridge with $uplink within ${deadline}s"
}

allow() {
    trap - HUP INT TERM
    if [ -e "$storage_held" ]; then
        log "storage migration holds CARP ($storage_held); allow stays 0 ($1)"
        return 0
    fi
    if sysctl net.inet.carp.allow=1 >/dev/null; then
        log "CARP allowed: $1"
    else
        log "FAILED to allow CARP ($1)"
    fi
}

waiter() {
    left=$deadline
    trap 'allow "waiter stopped by a signal"; exit 0' HUP INT
    trap 'log "waiter terminated (shutdown?); CARP stays held"; exit 0' TERM
    log "holding CARP until $uplink is stable for ${settle}s and carries a vhid $vhid advertisement (deadline ${deadline}s)"
    wait_tap
    while [ "$left" -gt 0 ]; do
        if stable && heard; then
            allow "vhid $vhid advertisement heard on $uplink"
            return 0
        fi
    done
    allow "deadline ${deadline}s reached without a stable $uplink and a vhid $vhid advertisement; peer down?"
}

start() {
    # An empty sysctl (carp not loaded yet) still counts as held: the
    # module reads the tunable when netif loads it.
    if [ "$(kenv -q net.inet.carp.allow)" != 0 ] || [ "$(sysctl -n net.inet.carp.allow 2>/dev/null)" = 1 ]; then
        log 'loader.conf hold not active (kenv allow != 0 or allow = 1); nothing to do'
        return 0
    fi
    # Only while the uplink is down: on a running NIC the change would reset it.
    if ifconfig "$uplink" 2>/dev/null | head -1 | grep -q '[<,]UP[,>]'; then
        log "$uplink already up; capabilities left as they are"
    else
        ifconfig "$uplink" -txcsum -tso || log "could not pre-mute TXCSUM/TSO on $uplink"
    fi
    if ! daemon -f "$self" wait; then
        log 'could not start the waiter; allowing CARP now'
        sysctl net.inet.carp.allow=1 >/dev/null 2>&1 || :
    fi
}

case "${1:-}" in
    start) start ;;
    wait) waiter ;;
    status)
        echo "allow=$(sysctl -n net.inet.carp.allow) loader=$(kenv -q net.inet.carp.allow)"
        tail -n 5 "$logfile" 2>/dev/null
        ;;
    *) echo 'usage: gonf-carp-gate start | wait | status' >&2; exit 1 ;;
esac
