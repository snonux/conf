# Dormant r-node migration candidate. Own only f3s_guard, never pod/CNI tables.
add table inet f3s_guard
delete table inet f3s_guard
table inet f3s_guard {
    set old_infra {
        type ipv4_addr;
        elements = {
            192.168.1.120, 192.168.1.121, 192.168.1.122, 192.168.1.123,
            192.168.1.125, 192.168.1.126, 192.168.1.127, 192.168.1.128,
            192.168.1.130, 192.168.1.131, 192.168.1.132, 192.168.1.133,
            192.168.1.138
        }
    }
    chain before_dnat {
        type filter hook prerouting priority -150; policy accept;
        # Preserve original host/NodePort destination before kube-proxy DNAT.
        iifname "enp0s5" fib daddr type local jump from_lan
    }
    chain from_lan {
        ct state established,related return
        # Recovery aliases are management-only, even for trusted lab sources.
        ip daddr { 10.98.0.120, 10.98.0.121, 10.98.0.122 } goto recovery
        # Homelab-local service trust; no trust of Wi-Fi/camera/wg2 subnets.
        ip saddr 10.20.0.0/24 ip daddr { 10.20.0.0/24, 192.168.1.0/24 } return
        ip6 saddr fd02:ca0b:f1cb:20::/64 ip6 daddr fd02:ca0b:f1cb:20::/64 return
        # Mixed old/new transport and service dependencies until retirement.
        ip saddr @old_infra return
        ip saddr 192.168.1.236 tcp dport 22 return
        ip6 saddr fd22:c702:acb7::/64 return
        # Individual routed wg2 identities; never trust the entire VPN range.
        ip saddr 10.99.0.2 ip daddr 10.20.0.0/24 tcp dport { 22, 80, 443 } return
        ip saddr 10.99.0.3 ip daddr 10.20.0.0/24 tcp dport 443 return
        # Other direct wg2 services require matching reviewed router/host/pod
        # permissions; current wg0/ingress paths retain their independent rules.
        # Essential errors and native NDP; do not restore RA/DHCPv6 trust.
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } return
        meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert } return
        # Preserve authenticated wg0 transport, including public gateway peers.
        udp dport 56709 return
        counter drop
    }
    chain recovery {
        ip saddr 10.99.0.2 tcp dport 22 return
        counter drop
    }
}
