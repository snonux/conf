replication_factor = {{.ReplicationFactor}}
consistency_mode = "{{.ConsistencyMode}}"

metadata_dir = "{{.MetadataDir}}"
data_dir = [
  { path = "{{.DataDir}}", capacity = "{{.DataCapacity}}" }
]
metadata_auto_snapshot_interval = "{{.MetadataAutoSnapshotInterval}}"

db_engine = "{{.DBEngine}}"

rpc_secret = {{.RPCSecret}}
rpc_bind_addr = "{{.RPCBindAddr}}"
rpc_public_addr = "{{.RPCPublicAddr}}"

[s3_api]
api_bind_addr = "{{.S3APIBindAddr}}"
s3_region = "{{.S3Region}}"
# Enables virtual-hosted-style addressing: a request whose Host is
# <bucket>.garage.f3s.buetow.org is resolved to that bucket. Needed because the AWS
# SDK derives the hostname as <bucket>.<endpoint>, and Taskwarrior's stock
# Fedora package has no sync.aws.force_path_style to fall back on. So the
# taskwarrior bucket is reached as taskwarrior.garage.f3s.buetow.org,
# proxied by relayd on the OpenBSD frontends.
#
# Path-style access is unaffected and keeps working alongside this (verified),
# so existing consumers such as watchos-app are not impacted.
root_domain = "{{.RootDomain}}"

[admin]
api_bind_addr = "{{.AdminAPIBindAddr}}"
