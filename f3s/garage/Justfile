# Garage cluster on FreeBSD f0–f2. The recipes call the repository's
# gonf.sh wrapper, which works from any directory.
ssh_host := "paul@f0.lan.buetow.org"
_garage_dir := justfile_directory()

# RPC and metrics credentials resolve through their foostore entries. Provision
# the external Prometheus metrics Secret before its approved Argo rollout.
# Deploy one node, verify health/quorum/metrics, then continue with the next.
# Package, garage account, local data and cluster layout must already exist.
deploy host:
    @case {{quote(host)}} in f0|f1|f2) ;; *) echo 'choose f0, f1 or f2' >&2; exit 2;; esac
    "{{_garage_dir}}/../../gonf.sh" push -privilege=doas -- -p22 -oBatchMode=yes -oStrictHostKeyChecking=yes "paul@{{host}}.lan.buetow.org" garage_config

# Read-only check of the external metrics Secret against its vault entry.
metrics-secret-check:
    python3 "{{_garage_dir}}/scripts/provision-metrics-secret.py"

# Requires rollout approval; creates only an absent Kubernetes Secret.
metrics-secret-create:
    python3 "{{_garage_dir}}/scripts/provision-metrics-secret.py" --apply

# Ensure gonf/secrets/garage/rpc_secret exists (openssl rand -hex 32).
# An existing Rex-era secret is copied once, preserving the live cluster's
# shared RPC identity instead of silently rotating it during the migration.
#
# This legacy initializer only maintains an ignored RPC fallback copy.
# The active RPC reference is mapped to Infra/garage-rpc; this target does not
# provision the new metrics credential and is not part of the cn3 rollout.
init-secrets:
    cd "{{_garage_dir}}/../.." && umask 077 && mkdir -p gonf/secrets/garage && if test ! -f gonf/secrets/garage/rpc_secret; then if test -f f3s/garage/secrets/rpc_secret; then install -m 600 f3s/garage/secrets/rpc_secret gonf/secrets/garage/rpc_secret; else openssl rand -hex 32 > gonf/secrets/garage/rpc_secret; fi; fi && chmod 600 gonf/secrets/garage/rpc_secret

# garage service status on f0
status:
    ssh {{ssh_host}} 'doas service garage status'

# Cluster layout (garage CLI on f0)
layout:
    ssh {{ssh_host}} garage layout show

# Aggregated stats
stats:
    ssh {{ssh_host}} 'garage stats -a'

# Create a bucket (usage: just bucket-create watchos-app)
bucket-create name:
    ssh {{ssh_host}} 'garage bucket create {{name}}'
